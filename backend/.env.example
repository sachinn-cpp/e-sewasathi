# e-SewaSathi backend environment
APP_NAME=e-SewaSathi
ENVIRONMENT=development
DEMO_MODE=true

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=e_sewasathi

# Auth - generate a long random value for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-only-secret-change-me-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private local storage
UPLOAD_DIR=../private_uploads
MAX_FILE_SIZE_MB=5
